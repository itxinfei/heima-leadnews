<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xftt.model.mappers.app.ApCommentMapper">

    <resultMap id="BaseResultMap" type="com.xftt.model.article.pojos.ApComment">
        <id column="id" property="id"/>
        <result column="author_id" property="authorId"/>
        <result column="author_name" property="authorName"/>
        <result column="entry_id" property="entryId"/>
        <result column="channel_id" property="channelId"/>
        <result column="type" property="type"/>
        <result column="content" property="content"/>
        <result column="image" property="image"/>
        <result column="likes" property="likes"/>
        <result column="reply" property="reply"/>
        <result column="flag" property="flag"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_time" property="updatedTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, author_id, author_name, entry_id, channel_id, type, content, image, likes, reply, flag, created_time, updated_time
    </sql>

    <select id="selectByEntryId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from ap_comment
        where entry_id = #{entryId} and flag = 0
        order by likes desc, created_time desc
        limit 100
    </select>

    <insert id="insert" parameterType="com.xftt.model.article.pojos.ApComment" useGeneratedKeys="true" keyProperty="id">
        insert into ap_comment (author_id, author_name, entry_id, content, likes, reply, flag, created_time)
        values (#{authorId}, #{authorName}, #{entryId}, #{content}, 0, 0, 0, now())
    </insert>

    <update id="addLike">
        update ap_comment set likes = likes + 1 where id = #{id}
    </update>

</mapper>
